;left:64px;bottom:76px;color:#fff;opacity:.85;font-size:36px;font-weight:700}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 22%,rgba(0,0,0,.15) 40%,rgba(0,0,0,.88) 70%,#000 100%)}"}, "cards": [{"name": "01", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{covcss}}</style></head><body><img class=\"bg\" src=\"https://pypl4325.github.io/anon-media/bank/ph-protein-03.jpg\" style=\"object-position:50% 50%\"><div class=\"shade\"></div><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"brand\">안온 단백질 연구소</div></div><div class=\"head\">단백질 보충제,<br><span class=\"hl\">모두에게</span><br>효과 있진 않았어요</div><div class=\"next\">누구한테 달랐는지 넘겨서 →</div></body></html>"}, {"name": "02", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 2/9</div></div><div class=\"lead\">부모님이 근력운동을<br>시작하셨다면</div><div class=\"bub\" style=\"top:370px\"><div class=\"say l\"><div class=\"who\">나</div>운동하시니까 단백질 보충제도<br>같이 사 드려야 하나?</div><div class=\"say r\"><div class=\"who\">안온 단백질 연구소</div>사기 전에<br><b>평소 드시는 양</b>부터 봐요</div></div><div class=\"ph2\" style=\"top:880px;height:380px\"><img src=\"https://pypl4325.github.io/anon-media/bank/ib114.jpg\" style=\"object-position:50% 35%\"></div></body></html>"}, {"name": "03", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 3/9</div></div><div class=\"lead\">허약한 어르신 <span class=\"mk\">295명</span>이<br>12주 동안 운동했어요</div><div class=\"stack\" style=\"top:400px\"><div class=\"box on\"><div class=\"k\">모두 똑같이</div><div class=\"t\">주 2회 근력운동<br><b>(1:1로 지도받음)</b></div></div><div class=\"box\"><div class=\"k\">절반만 더 받은 것</div><div class=\"t\">유청 단백질 20g + 식단 상담<br><small style=\"font-size:34px;font-weight:700;color:#6B6458\">목표: 하루 몸무게 1kg당 1.2~1.5g</small></div></div></div><div class=\"ph2\" style=\"top:1000px;height:250px\"><img src=\"https://pypl4325.github.io/anon-media/bank/ph-gym-02.jpg\" style=\"object-position:50% 55%\"></div><div class=\"src\">출처 ① · 평균 74세</div></body></html>"}, {"name": "04", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 4/9</div></div><div class=\"lead\">보충제를 더 먹은 쪽,<br>전체로는 <b class=\"warn\">차이 없음</b></div><div class=\"stack\" style=\"top:420px\"><div class=\"rows three\"><div class=\"row\"><div class=\"w\">다리 근력</div><div class=\"g\">=</div><div class=\"s\">차이 없음</div></div><div class=\"row\"><div class=\"w\">팔다리 근육량</div><div class=\"g\">=</div><div class=\"s\">차이 없음</div></div><div class=\"row on\"><div class=\"w\">몸 기능</div><div class=\"g\">=</div><div class=\"s\">차이 없음</div></div></div><div class=\"note\">운동만 한 쪽과 비교한 결과예요.<br>보충제 쪽은 하루 단백질이 실제로 몸무게 1kg당 0.4g 더 늘었는데도요.</div></div><div class=\"ph2\" style=\"top:880px;height:380px\"><img src=\"https://pypl4325.github.io/anon-media/bank/ib030.jpg\" style=\"object-position:50% 40%\"></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "05", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 5/9</div></div><div class=\"lead\">그런데 <span class=\"mk\">평소 적게 먹던 사람</span>은<br>다리 근력이 더 늘었어요</div><div class=\"big\" style=\"top:400px;font-size:280px;letter-spacing:-14px\"><span class=\"mk2\">+6.4kg</span></div><div class=\"sub\" style=\"top:700px\">평소 하루 몸무게 1kg당 1.2g 미만</div><div class=\"stack\" style=\"top:810px\"><div class=\"box on\"><div class=\"k\">0.8g 미만이던 사람은</div><div class=\"t\">다리 근력 <b>+10.9kg</b> 더</div></div><div class=\"note\" style=\"font-size:34px;color:#8A8274\">작은 묶음만 따로 본 분석이라, 더 큰 시험으로 확인이 필요해요.</div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "06", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 6/9</div></div><div class=\"lead\">이미 충분히 먹는다면?<br>다른 실험도 <b class=\"warn\">차이 없음</b></div><div class=\"stack\" style=\"top:420px\"><div class=\"box\"><div class=\"k\">평균 66세 남성 30명 · 12주 근력운동</div><div class=\"t\">운동 직후 40g, 자기 전 40g,<br>운동만 한 쪽 비교</div></div><div class=\"grid\" style=\"position:static\"><div class=\"box on\"><div class=\"k\">근육 두께·근력</div><div class=\"t\"><b>세 쪽 모두</b><br>비슷하게 늘음</div></div><div class=\"box\"><div class=\"k\">운동만 해도</div><div class=\"t\">다리 누르기<br>+28.3kg</div></div></div><div class=\"note\">평소 몸무게 1kg당 1.0g 넘게 먹던 사람들이었어요. 이럴 땐 보충제보다 운동이 먼저예요.</div></div><div class=\"src\">출처 ②</div></body></html>"}, {"name": "07", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 7/9</div></div><div class=\"lead\">내 기준 찾기<br><span class=\"mk\">몸무게 × 1.2g</span></div><div class=\"stack\" style=\"top:420px\"><div class=\"rows\"><div class=\"row\"><div class=\"w\">50kg</div><div class=\"g\">60g</div><div class=\"s\">하루</div></div><div class=\"row on\"><div class=\"w\">60kg</div><div class=\"g\">72g</div><div class=\"s\">하루</div></div><div class=\"row\"><div class=\"w\">70kg</div><div class=\"g\">84g</div><div class=\"s\">하루</div></div></div><div class=\"note\">이보다 적게 먹는다면 음식이나 보충제로 채울 여지가 있어요. 이만큼 먹는다면 운동이 먼저예요.</div><div class=\"note\" style=\"font-size:34px;color:#8A8274\">사람마다 달라요. 콩팥 질환이 있거나 식사 제한을 받는 중이면 의사와 먼저 상의하세요.</div></div><div class=\"src\">출처 ① 기준으로 계산</div></body></html>"}, {"name": "08", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{covcss}}</style></head><body><img class=\"bg\" src=\"https://pypl4325.github.io/anon-media/bank/ph-egg-02.jpg\" style=\"object-position:50% 50%\"><div class=\"shade\"></div><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"brand\">안온 단백질 연구소 · 8/9</div></div><div class=\"head\" style=\"font-size:76px;letter-spacing:-3px\">오늘 먹은 단백질,<br>이렇게 세어 보세요<br><span class=\"hl\">달걀 1개 8g</span> · 두부 80g 8g<br>우유 1컵(200mL) 6g</div><div class=\"next\">고기·생선 반찬도 함께 더해 보세요 · 출처 ③</div></body></html>"}, {"name": "09", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">단백질 상식 10</div><div class=\"pg\">안온 단백질 연구소 · 9/9</div></div><div class=\"end\">저장해두고<br><span class=\"mk\">보충제 고를 때</span> 참고하세요!</div><div class=\"box nb on\"><div class=\"k\">근육 지키는 법</div><div class=\"t\">매일 하나씩 올려요.<br><b>놓치기 싫으면</b> 팔로우해 두세요</div></div><div class=\"share\"><span class=\"mk\">✈ 부모님 보충제 고민하는 친구에게 보내 주세요</span></div><div class=\"lk\"><div class=\"q\">도움이 됐다면 두 번만 눌러 주세요</div><div class=\"sp\" style=\"left:120px;top:96px;transform:rotate(-35deg)\"></div><div class=\"sp\" style=\"left:244px;top:86px\"></div><div class=\"sp\" style=\"left:368px;top:96px;transform:rotate(35deg)\"></div><div class=\"ht\" style=\"left:56px;top:100px\">♥</div><div class=\"ht\" style=\"left:410px;top:100px\">♥</div><div class=\"btn like\"><span style=\"color:#111\">♥&nbsp;</span>좋아요</div><div class=\"btn fol\">+ 팔로우</div><div class=\"tap\"></div><div class=\"p\"><span>프로필</span>을 누르면 다른 단백질 정보도 볼 수 있어요</div></div><div class=\"srcs\">출처 ① Biersteker 외, J Nutr Health Aging 2026, 허약 노인 295명 12주 무작위 시험 2차 분석 ② Klemp 외, JISSN 2025, 고령 남성 30명 12주 ③ 대한당뇨병학회 식품교환표(2010 개정)</div></body></html>"}], "cardSize": [1080, 1350], "thumbs": true, "reel": {"file": "reel.html", "size": [1080, 1920], "fps": 30}, "cardReel": {"bgm": "https://pypl4325.github.io/anon-media/bank/bgm-series.mp3", "volume": 0.3}}