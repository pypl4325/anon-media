r-spacing:-3px}.row .s{font-size:30px;font-weight:700;color:#8A8274;margin-top:6px}.row.on{background:#1A1A1A;color:#fff}.row.on .w,.row.on .s{color:#CFC6B4}.row.on .g{color:#3DDC97}.ck{display:flex;gap:26px;align-items:flex-start;background:#fff;border-radius:28px;padding:34px 40px;box-shadow:0 2px 0 #EDE4D3}.ck .c{flex:0 0 64px;height:64px;border-radius:16px;background:#3DDC97;display:flex;align-items:center;justify-content:center;font-size:44px;font-weight:900}.ck .t{font-size:44px;font-weight:800;line-height:1.36;letter-spacing:-1.5px}.ck .t small{display:block;font-size:32px;font-weight:600;color:#8A8274;margin-top:6px}.vs{text-align:center;font-weight:900;font-size:56px;color:#8A8274}.arrow{font-size:54px;font-weight:900}</style></head><body>"}, "cards": [{"name": "01", "html": "{{ph}}<img class=\"bg\" src=\"https://pypl4325.github.io/anon-media/bank/ph-protein-01.jpg\" style=\"object-position:50% 60%\"><div class=\"shade\"></div><div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"brand\">안온 단백질 연구소</div></div><div class=\"head\">콩·완두 단백질도<br><span class=\"hl\">유청만큼</span><br>근육 붙었어요</div><div class=\"next\">내 쉐이크 1회분, 이 숫자면 충분 →</div></body></html>"}, {"name": "02", "html": "{{ph}}<img class=\"bg\" src=\"https://pypl4325.github.io/anon-media/bank/ph-protein-06.jpg\" style=\"object-position:50% 50%\"><div class=\"shade\" style=\"background:linear-gradient(180deg,rgba(0,0,0,.5) 0%,rgba(0,0,0,.05) 30%,rgba(0,0,0,.35) 55%,rgba(0,0,0,.9) 80%,#000 100%)\"></div><div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pgw\">안온 단백질 연구소 · 2/9</div></div><div class=\"bub\" style=\"top:760px\">\"우유 마시면 배가 아파서<br>식물성 쉐이크로 바꿨는데,<br>근육엔 손해일까?\"</div><div class=\"sub2\" style=\"bottom:90px\">지금 찬장에 있는 그 쉐이크 얘기예요.<br>연구로 비교해 봤어요.</div></body></html>"}, {"name": "03", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 3/9</div></div><div class=\"lead\">근력운동 처음 시작한<br>성인 372명, 연구 5편</div><div class=\"stack\" style=\"top:420px\"><div class=\"rows\"><div class=\"box\"><div class=\"k\">유청 단백질</div><div class=\"t\">근육량 ↑<br>체지방 ↓</div></div><div class=\"box\"><div class=\"k\">콩·완두 단백질</div><div class=\"t\">근육량 ↑<br>체지방 ↓</div></div></div><div class=\"box on\"><div class=\"k\">두 쪽을 비교하면</div><div class=\"t\">의미 있는 <b>차이 없음</b></div></div><div class=\"note\">18~59세, 운동과 함께 먹은 연구만 모았어요.<br>몸 구성은 <b>DEXA</b>(뼈·지방·근육 나눠 재는 X선)로 쟀어요.</div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "04", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 4/9</div></div><div class=\"lead\">그런데 예외도 있어요</div><div class=\"stack\" style=\"top:340px\"><div class=\"box\"><div class=\"k\">9개월 동안 본 연구 1편</div><div class=\"t\">하루 약 22g씩 먹었더니<br>유청 쪽 근육량이 <span class=\"x\">조금 더</span> 늘었어요</div></div><div class=\"box\"><div class=\"k\">치아씨 단백질</div><div class=\"t\">연구가 1편뿐이고<br>근육량 변화가 없었어요</div></div><div class=\"note\">연구 수가 적어서 \"완전히 똑같다\"고 말할 순 없어요. 사람마다 달라요. 기준은 6장의 <b>한 번에 먹는 양</b>이에요.</div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "05", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 5/9</div></div><div class=\"lead\">운동 직후 한 번 먹었을 때<br>근육 합성은?</div><div class=\"stack\" style=\"top:420px\"><div class=\"box\"><div class=\"k\">51개 실험을 한 번에 비교</div><div class=\"t\">유청 · 달걀 · <span class=\"mk\">완두</span> · <span class=\"mk\">마이코프로틴</span><br>모두 순위가 비슷하게 위쪽</div></div><div class=\"note\"><b>마이코프로틴</b>은 곰팡이류(균류)로 만든 단백질이에요.<br>다만 통계로 확실한 건 <b>유청</b>뿐이고, 근거 수준은 낮음~중간이에요.</div></div><div class=\"src\">출처 ②</div></body></html>"}, {"name": "06", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 6/9</div></div><div class=\"lead\">반응이 가장 컸던 양</div><div class=\"big\"><span class=\"mk2\">18~25<small>g</small></span></div><div class=\"stack\" style=\"top:740px\"><div class=\"note\" style=\"font-size:44px\">운동 직후 <b>한 번에</b> 이만큼일 때<br>근육 합성 반응이 가장 높게 나왔어요.<br>콩·완두든 유청이든 같아요.</div></div><div class=\"src\">출처 ②</div></body></html>"}, {"name": "07", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 7/9</div></div><div class=\"lead\">콩은 조금 더 드세요</div><div class=\"stack\" style=\"top:340px\"><div class=\"rows\"><div class=\"row\"><div class=\"w\">유청 분리</div><div class=\"g\">19g</div><div class=\"s\">류신 2g</div></div><div class=\"row on\"><div class=\"w\">콩 분리</div><div class=\"g\">26g</div><div class=\"s\">류신 2g</div></div></div><div class=\"note\">근육 신호를 켜는 아미노산 <b>류신</b>을 똑같이 2g 맞추려고 콩을 더 줬더니, 12주 뒤 근육량·근력 증가가 비슷했어요(61명).</div><div class=\"box on\"><div class=\"k\">내 쉐이크로 바꾸면</div><div class=\"t\">콩·완두 쉐이크는 1회 단백질이<br><b>20g 넘는 것</b>으로 고르세요</div></div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "08", "html": "{{cr}}<div class=\"top\"><div class=\"badge\">단백질 상식 9</div><div class=\"pg\">안온 단백질 연구소 · 8/9</div></div><div class=\"lead\">쉐이크 살 때<br>뒷면에서 볼 곳 3개</div><div class=\"stack\" style=\"top:420px\"><div class=\"ck\"><div class=\"c\">✓</div><div class=\"t\">영양정보 <span class=\"mk\">1회 단백질 g</span><small>18~25g인지, 콩·완두면 20g 넘게</small></div></div><div class=\"ck\"><div class=\"c\">✓</div><div class=\"t\">원재료명 첫 줄<small>분리대두단백·완두단백·분리유청단백</small></div></div><div class=\"ck\"><div class=\"c\">✓</div><div class=\"t\">1회 제공량(스쿱 수)<small>2스쿱 기준이면 반만 먹을 때 절반</small></div></div><div class=\"note\">그리고 쉐이크만으론 안 돼요. 연구는 모두 <b>근력운동과 함께</b>였어요.</div></div></body></html>"}, {"name": "09", "html": "{{cr}}<style>.end{position:absolute;left:72px;right:72px;font-weight:900;font-size:72px;letter-spacing:-3px;line-height:1.2}.nb{position:absolute;left:72px;right:72px}.lk{position:absolute;top:700px;left:72px;right:72px;height:480px;background:#1A1A1A;border-radius:28px}.lk .q{position:absolute;top:42px;left:0;right:0;text-align:center;color:#CFC6B4;font-size:34px;font-weight:800}.btn{position:absolute;top:150px;height:170px;border-radius:30px