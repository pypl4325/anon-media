tent:space-between}.badge{background:#FF6FA8;color:#111;font-weight:900;font-size:40px;padding:14px 30px;border-radius:999px;letter-spacing:-1px}.brand{color:#fff;opacity:.85;font-weight:700;font-size:30px;letter-spacing:-.5px}.head{position:absolute;left:64px;right:64px;bottom:160px;color:#fff;font-weight:900;font-size:104px;line-height:1.14;letter-spacing:-4px;text-shadow:0 6px 30px rgba(0,0,0,.6)}.hl{color:#FF6FA8}.next{position:absolute;left:64px;bottom:76px;color:#fff;opacity:.85;font-size:36px;font-weight:700}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 22%,rgba(0,0,0,.15) 40%,rgba(0,0,0,.88) 70%,#000 100%)}"}, "cards": [{"name": "01", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{covcss}}</style></head><body><img class=\"bg\" src=\"https://pypl4325.github.io/anon-media/bank/ph-alcohol-04.jpg\" style=\"object-position:50% 50%\"><div class=\"shade\"></div><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"brand\">안온 단백질 연구소</div></div><div class=\"head\">와인 vs 맥주<br>심장엔 <span class=\"hl\">와인</span>?</div><div class=\"next\">21% 낮았지만, 와인 덕은 아닌 이유 →</div></body></html>"}, {"name": "02", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 2/10</div></div><div class=\"lead\">회식 메뉴 고를 때</div><div class=\"bub\" style=\"top:310px\"><div class=\"say l\"><div class=\"who\">나</div>맥주 말고 와인 마시면<br>심장엔 좋다던데?</div><div class=\"say r\"><div class=\"who\">안온 단백질 연구소</div>숫자는 맞는데,<br><b>와인 덕</b>은 아니에요</div></div><div class=\"ph2\" style=\"top:800px;height:440px\"><img src=\"https://pypl4325.github.io/anon-media/bank/ib136.jpg\" style=\"object-position:50% 45%\"></div></body></html>"}, {"name": "03", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 3/10</div></div><div class=\"lead\">영국 성인 34만 명을<br>13년 넘게 지켜봤어요</div><div class=\"grid\" style=\"top:420px\"><div class=\"box on\"><div class=\"k\">영국 바이오뱅크 참여자</div><div class=\"t\" style=\"font-size:76px;letter-spacing:-3px\"><b>340,924명</b></div></div><div class=\"box\"><div class=\"k\">평균 추적 기간</div><div class=\"t\" style=\"font-size:76px;letter-spacing:-3px\">13년+</div></div></div><div class=\"stack\" style=\"top:760px\"><div class=\"note\">비교 기준은 <span class=\"mk\">안 마시거나 가끔</span><br>(일주일 20g 미만) 마시는 사람이에요.<br>2026년 3월 미국심장학회에서 발표했어요</div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "04", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 4/10</div></div><div class=\"lead\">와인을 적당히 마신 쪽<br>심장·혈관 사망이</div><div class=\"bn\" style=\"top:420px\"><div class=\"v\"><span>21%</span></div><div class=\"d\">낮았어요</div></div><div class=\"stack\" style=\"top:760px\"><div class=\"lbl\">같은 연구, 다른 술은 반대였어요</div><div class=\"rows\"><div class=\"row\"><div class=\"w\">와인 · 적당히</div><div class=\"g\">21% ↓</div></div><div class=\"row on\"><div class=\"w\">맥주·사이다·증류주 · 적게</div><div class=\"g\">9% ↑</div></div></div></div><div class=\"src\">출처 ① · 심장·혈관 질환 사망 기준</div></body></html>"}, {"name": "05", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 5/10</div></div><div class=\"lead\">그런데 와인이 지켜 준<br>증거는 <span class=\"warn\">아니에요</span></div><div class=\"stack lst\" style=\"top:420px\"><div class=\"chk\"><div class=\"n\">1</div><div class=\"t\">지켜보기만 한 연구예요<small>원인이라는 증명은 아니에요</small></div></div><div class=\"chk\"><div class=\"n\">2</div><div class=\"t\">와인 쪽은 식단이 더 좋았어요<small>식사와 함께 마시는 경우가 많았어요</small></div></div><div class=\"chk\"><div class=\"n\">3</div><div class=\"t\">처음 한 번 물어본 양이에요<small>그 뒤에 바뀐 양은 몰라요</small></div></div></div><div class=\"src\">출처 ①②</div></body></html>"}, {"name": "06", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 6/10</div></div><div class=\"lead\">많이 마시면<br>종류 상관없이 올라가요</div><div class=\"ph2\" style=\"top:350px;height:330px\"><img src=\"https://pypl4325.github.io/anon-media/bank/ph-alcohol-01.jpg\" style=\"object-position:50% 50%\"></div><div class=\"stack\" style=\"top:720px\"><div class=\"rows three\"><div class=\"row\"><div class=\"w\">모든 원인 사망</div><div class=\"g\">24%↑</div></div><div class=\"row on\"><div class=\"w\">암 사망</div><div class=\"g\">36%↑</div></div><div class=\"row\"><div class=\"w\">심장병 사망</div><div class=\"g\">14%↑</div></div></div><div class=\"note\" style=\"font-size:36px\">'많이' = 여자 하루 20g, 남자 하루 40g 넘게</div></div><div class=\"src\">출처 ①</div></body></html>"}, {"name": "07", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 7/10</div></div><div class=\"lead\">세계보건기구는<br>'안전한 양은 없다'</div><div class=\"stack\" style=\"top:420px\"><div class=\"box on\"><div class=\"k\">국제암연구소 분류</div><div class=\"t\">술은 <b>1군 발암물질</b><br>담배·석면과 같은 묶음이에요</div></div><div class=\"grid\" style=\"position:static\"><div class=\"box\"><div class=\"k\">술이 일으키는 암</div><div class=\"t\">최소 7가지</div><div class=\"r\">대장암·유방암 포함</div></div><div class=\"box\"><div class=\"k\">유럽 술 관련 암</div><div class=\"t\">약 절반</div><div class=\"r\">많이 마시지 않는 사람에게서</div></div></div></div><div class=\"src\">출처 ③</div></body></html>"}, {"name": "08", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 8/10</div></div><div class=\"lead\">이 연구의 '많이'는<br>생각보다 가까워요</div><div class=\"stack\" style=\"top:420px\"><div class=\"lbl\">하루 알코올, 이 선을 넘으면 '많이'</div><div class=\"rows\"><div class=\"row on\"><div class=\"w\">여자</div><div class=\"g\">20g</div><div class=\"s\">표준 잔 약 1.5잔</div></div><div class=\"row\"><div class=\"w\">남자</div><div class=\"g\">40g</div><div class=\"s\">표준 잔 약 3잔</div></div></div><div class=\"note\" style=\"margin-top:20px\">표준 잔 1잔 = 순수 알코올 약 14g.<br>이 선 아래라고 <span class=\"mk\">안전하다는 뜻은 아니에요</span></div></div><div class=\"src\">출처 ①②③</div></body></html>"}, {"name": "09", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 9/10</div></div><div class=\"lead\">술자리 전에 이것만</div><div class=\"stack lst\" style=\"top:320px\"><div class=\"chk\"><div class=\"n\">1</div><div class=\"t\">안 마시던 사람은 시작하지 않기<small>심장 때문에 마실 근거는 없어요</small></div></div><div class=\"chk\"><div class=\"n\">2</div><div class=\"t\">종류보다 양부터 줄이기<small>와인으로 바꿔도 많이 마시면 같아요</small></div></div><div class=\"chk\"><div class=\"n\">3</div><div class=\"t\">검진 땐 마시는 양 그대로 말하기<small>일주일에 몇 번, 몇 잔인지</small></div></div></div><div class=\"src\">출처 ①③</div></body></html>"}, {"name": "10", "html": "<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css\"><style>{{css}}</style></head><body><div class=\"top\"><div class=\"badge\">이번 주 건강 이슈 15</div><div class=\"pg\">안온 단백질 연구소 · 10/10</div></div><div class=\"end\">저장해두고<br><span class=\"mk\">술자리 전에</span> 꺼내 보세요!</div><div class=\"box nb on\"><div class=\"k\">댓글로 알려 주세요</div><div class=\"t\">회식 땐 주로 <b>와인·맥주·소주</b><br>중에 뭐 드세요?</div></div><div class=\"share\"><span class=\"mk\">✈ 회식 잦은 친구에게 보내 주세요</span></div><div class=\"lk\"><div class=\"q\">도움이 됐다면 두 번만 눌러 주세요</div><div class=\"sp\" style=\"left:120px;top:96px;transform:rotate(-35deg)\"></div><div class=\"sp\" style=\"left:244px;top:86px\"></div><div class=\"sp\" style=\"left:368px;top:96px;transform:rotate(35deg)\"></div><div class=\"ht\" style=\"left:56px;top:100px\">♥</div><div class=\"ht\" style=\"left:410px;top:100px\">♥</div><div class=\"btn like\"><span style=\"color:#111\">♥&nbsp;</span>좋아요</div><div class=\"btn fol\">+ 팔로우</div><div class=\"tap\"></div><div class=\"p\"><span>프로필</span>을 누르면 다른 성분 정보도 볼 수 있어요</div></div><div class=\"srcs\">출처 ① 미국심장학회(ACC) 보도자료(2026.3.19), ACC.26 발표 Li·Chen 'Alcohol Use at Mid-Life and All-Cause and Cause-Specific Mortality', 영국 바이오뱅크 340,924명 ② ScienceDaily 재보도(2026.11.16) ③ 세계보건기구 유럽 'No level of alcohol consumption is safe for our health'(2023.1.4)</div></body></html>"}], "cardSize": [1080, 1350], "thumbs": true, "reel": {"file": "reel.html", "size": [1080, 1920], "fps": 30}, "cardReel": {"bgm": "https://pypl4325.github.io/anon-media/bank/bgm-series.mp3", "volume": 0.3}}